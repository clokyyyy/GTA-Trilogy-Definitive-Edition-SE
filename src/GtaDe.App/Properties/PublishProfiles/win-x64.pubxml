<?xml version="1.0" encoding="utf-8"?>
<!--
  Packs the editor into a single GtaDeSaveEditor.exe: every managed DLL, the native Skia/HarfBuzz/ANGLE
  libraries, deps.json and runtimeconfig.json are bundled inside it. Native libraries are unpacked
  to a cache under %TEMP%\.net on first launch. Requires the .NET 9 Desktop Runtime.

  dotnet publish src\GtaDe.App -p:PublishProfile=win-x64
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\dist\</PublishDir>
  </PropertyGroup>
</Project>
