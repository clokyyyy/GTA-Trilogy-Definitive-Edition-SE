<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="GtaDe.App.Views.ConfirmDialog"
        Width="440" SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Title="Confirm">

  <StackPanel Margin="24" Spacing="16">
    <TextBlock Name="TitleText" FontSize="17" FontWeight="SemiBold" />
    <TextBlock Name="MessageText" Classes="Subtle" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
      <Button Name="CancelButton" Content="Cancel" MinWidth="92" />
      <Button Name="ConfirmButton" Classes="Accent" Content="Continue" MinWidth="92" IsDefault="True" />
    </StackPanel>
  </StackPanel>

</Window>
