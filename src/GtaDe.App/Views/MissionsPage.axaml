<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GtaDe.App.ViewModels"
             xmlns:c="using:GtaDe.App.Controls"
             x:Class="GtaDe.App.Views.MissionsPage"
             x:DataType="vm:ToggleGroupsPageViewModel">

  <DockPanel LastChildFill="True">

    <Border DockPanel.Dock="Top" Padding="30,16"
            BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0" VerticalAlignment="Center" Classes="Subtle"
                   Text="{Binding OverallSummary}" />
        <Button Grid.Column="1" Content="{Binding CompleteEverythingLabel}"
                Command="{Binding CompleteEverythingCommand}" />
      </Grid>
    </Border>

    <ScrollViewer>
      <ItemsControl Margin="30,20" ItemsSource="{Binding Groups}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <c:CardGrid Spacing="16" MaxColumns="3" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="vm:ToggleGroup">
            <Border Classes="Card">
              <StackPanel Spacing="14">

                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Classes="SectionTitle" Text="{Binding Name}" />
                    <TextBlock Classes="Muted" FontSize="12" Text="{Binding Subtitle}"
                               IsVisible="{Binding HasSubtitle}" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4" Width="120">
                    <TextBlock Classes="Mono" FontSize="12" HorizontalAlignment="Right"
                               Text="{Binding Summary}" />
                    <ProgressBar Value="{Binding Progress}" Maximum="100" Height="4" />
                  </StackPanel>
                </Grid>

                <ItemsControl ItemsSource="{Binding Items}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:ToggleItem">
                      <CheckBox IsChecked="{Binding IsComplete}" Margin="0,2"
                                HorizontalAlignment="Stretch">
                        <StackPanel Spacing="1">
                          <TextBlock Text="{Binding Name}" />
                          <TextBlock Classes="Muted" FontSize="11.5" Text="{Binding Detail}"
                                     IsVisible="{Binding HasDetail}" TextWrapping="Wrap" />
                        </StackPanel>
                      </CheckBox>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

  </DockPanel>
</UserControl>
