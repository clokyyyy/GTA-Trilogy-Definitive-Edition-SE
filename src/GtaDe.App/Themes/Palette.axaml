<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    One accent and a neutral ramp, defined once per theme. Everything else in the app refers to
    these keys, so switching between light and dark is a single swap with no per-control overrides.
  -->
  <ResourceDictionary.ThemeDictionaries>

    <ResourceDictionary x:Key="Dark">
      <Color x:Key="AccentColor">#F0A431</Color>
      <Color x:Key="AccentHoverColor">#FFB849</Color>
      <Color x:Key="AccentPressedColor">#D08A1F</Color>
      <Color x:Key="AccentSoftColor">#3A2D16</Color>

      <Color x:Key="WindowBackgroundColor">#13151A</Color>
      <Color x:Key="SidebarBackgroundColor">#0E1014</Color>
      <Color x:Key="SurfaceColor">#1B1E25</Color>
      <Color x:Key="SurfaceRaisedColor">#232730</Color>
      <Color x:Key="SurfaceHoverColor">#2A2F3A</Color>
      <Color x:Key="BorderColor">#2E3341</Color>
      <Color x:Key="BorderStrongColor">#3C4354</Color>

      <Color x:Key="TextPrimaryColor">#F2F4F8</Color>
      <Color x:Key="TextSecondaryColor">#A3ABBC</Color>
      <Color x:Key="TextMutedColor">#6E7687</Color>

      <Color x:Key="SuccessColor">#4ED88A</Color>
      <Color x:Key="WarningColor">#F2B035</Color>
      <Color x:Key="DangerColor">#F06060</Color>
      <Color x:Key="InfoColor">#5BA8F5</Color>
    </ResourceDictionary>

    <ResourceDictionary x:Key="Light">
      <Color x:Key="AccentColor">#C87A0A</Color>
      <Color x:Key="AccentHoverColor">#E08E16</Color>
      <Color x:Key="AccentPressedColor">#A66206</Color>
      <Color x:Key="AccentSoftColor">#FBEFD9</Color>

      <Color x:Key="WindowBackgroundColor">#F4F5F8</Color>
      <Color x:Key="SidebarBackgroundColor">#EAECF1</Color>
      <Color x:Key="SurfaceColor">#FFFFFF</Color>
      <Color x:Key="SurfaceRaisedColor">#FFFFFF</Color>
      <Color x:Key="SurfaceHoverColor">#EDEFF4</Color>
      <Color x:Key="BorderColor">#DCDFE8</Color>
      <Color x:Key="BorderStrongColor">#C3C8D6</Color>

      <Color x:Key="TextPrimaryColor">#141720</Color>
      <Color x:Key="TextSecondaryColor">#555E72</Color>
      <Color x:Key="TextMutedColor">#848C9E</Color>

      <Color x:Key="SuccessColor">#15874C</Color>
      <Color x:Key="WarningColor">#9A6407</Color>
      <Color x:Key="DangerColor">#C0392B</Color>
      <Color x:Key="InfoColor">#1A6FC4</Color>
    </ResourceDictionary>

  </ResourceDictionary.ThemeDictionaries>

  <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}" />
  <SolidColorBrush x:Key="AccentHoverBrush" Color="{DynamicResource AccentHoverColor}" />
  <SolidColorBrush x:Key="AccentPressedBrush" Color="{DynamicResource AccentPressedColor}" />
  <SolidColorBrush x:Key="AccentSoftBrush" Color="{DynamicResource AccentSoftColor}" />

  <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{DynamicResource WindowBackgroundColor}" />
  <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="{DynamicResource SidebarBackgroundColor}" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="{DynamicResource SurfaceColor}" />
  <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{DynamicResource SurfaceRaisedColor}" />
  <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{DynamicResource SurfaceHoverColor}" />
  <SolidColorBrush x:Key="PanelBorderBrush" Color="{DynamicResource BorderColor}" />
  <SolidColorBrush x:Key="BorderStrongBrush" Color="{DynamicResource BorderStrongColor}" />

  <SolidColorBrush x:Key="TextPrimaryBrush" Color="{DynamicResource TextPrimaryColor}" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="{DynamicResource TextSecondaryColor}" />
  <SolidColorBrush x:Key="TextMutedBrush" Color="{DynamicResource TextMutedColor}" />

  <SolidColorBrush x:Key="SuccessBrush" Color="{DynamicResource SuccessColor}" />
  <SolidColorBrush x:Key="WarningBrush" Color="{DynamicResource WarningColor}" />
  <SolidColorBrush x:Key="DangerBrush" Color="{DynamicResource DangerColor}" />
  <SolidColorBrush x:Key="InfoBrush" Color="{DynamicResource InfoColor}" />

  <CornerRadius x:Key="CardRadius">10</CornerRadius>
  <CornerRadius x:Key="ControlRadius">6</CornerRadius>

</ResourceDictionary>
